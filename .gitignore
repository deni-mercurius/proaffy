# Working notes. Never committed, never published.
_notes/

# Photography masters, 18.6 MB of them. The derivatives under assets/photos/
# are what the site serves and what is committed; these are the negatives.
# Git would keep them at full size forever, in a public repo, to rebuild files
# that are already in the repo.
_src/

# Python
__pycache__/
*.py[cod]

# Editor and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Derived from the woff2 by _tools/make-og.py, not shipped.
assets/fonts/*.ttf

# wrangler writes an account cache into whatever folder it runs in. It is local state and
# must never be published: the same cache was served publicly on another project in 2026-09.
.wrangler/
