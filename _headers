# One /* rule sets every security header. The asset rules set only
# Cache-Control, so no header is ever written by two rules matching the
# same request.
#
# The Content-Security-Policy below was withheld until it could be strict.
# The fonts are now local and the 23 inline style attributes are gone, so
# style-src and font-src need no escape hatch and script-src needs no hashes.
#
# form-action, NOT connect-src. The forms post natively rather than by fetch,
# so a connect-src entry alone would block them while looking correct.
#
# No hashes for the JSON-LD blocks: a script whose type is not a JavaScript
# MIME type is a data block and is not subject to script-src.
#
# cloudflareinsights.com is in script-src and connect-src because the host
# injects its analytics beacon into every response AFTER the HTML leaves this
# repo. Nothing here references it, so it is invisible locally: the first
# strict policy blocked it and silently stopped analytics collecting. Found by
# loading the deployed pages in a browser, not by reading this file.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=15552000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; form-action 'self' https://api.web3forms.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Immutable, because these are versioned by a query string in the markup:
# a change ships as a new URL, so a returning visitor never needs to revalidate.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are the strongest immutable case on the site: the filename carries the
# family and weight, so a change is a new file rather than new bytes at the same
# name. Without this rule they were revalidated on every page load, which is 75
# KB of round trips for four files that cannot change.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# 30 days and NOT immutable: images are referenced by a stable filename, so
# replacing one under the same name has to reach people who already have it.
/assets/images/*
  Cache-Control: public, max-age=2592000
